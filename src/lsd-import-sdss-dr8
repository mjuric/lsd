import sys
import getopt
import lsd
import lsd.sdss_dr8  as sdss
from lsd.utils import *
from lsd.tui import *
import numpy as np

def usage():
	print "Usage: %s [-c|--create] <sdss_table> <sweep_file_dir>" % sys.argv[0]

optlist, (dbdir,), (tabname, sweep_dir) = tui_getopt('c', ['create'], 2, usage)

create = False
for (o, a) in optlist:
	if o == '-c' or o == '--create':
		create = True

#
# Actual work
#
db = lsd.DB(dbdir)

files = shell('find "' + sweep_dir + '" -name "strip.*"').splitlines()

print "Importing SDSS catalog:"
sdss.import_from_sweeps(db, tabname, files, create)
print " done."

print "Building neighbor cache ",
db.build_neighbor_cache(tabname)
print " done."

print "Computing summary statistics ",
db.compute_summary_stats(tabname)
print " done."
print "Total number of objects in catalog: ", db.table(tabname).nrows()
