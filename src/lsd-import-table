#!/usr/bin/env python
#
# Example: ./lsd-import-table $HOME/LSD agn agn.txt
#

import sys
import getopt
from lsd import DB
import surveys.small_table as small
from lsd.utils import *
from lsd.tui import *
import numpy as np

def usage():
	print "Usage: %s <dbdir> <table_name> <filename>" % sys.argv[0]

optlist, (dbdir) ,(dbdir, tabname, files) = tui_getopt('c', ['create'], 3, usage)

create = True

#
# Actual work
#
db = DB(dbdir)

files = [files]

db.begin_transaction(join=True)

print "Importing a table:"
small.import_from_catalogs(db, tabname, files, create)
print " done."

# Commit the result

db.commit()

# Done
print "Total number of objects in table: ", db.table(tabname).nrows()
