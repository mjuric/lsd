#!/usr/bin/env python
#
# Example: ./lsd-import-table agn agn_assaf.dat
#

import sys
import getopt
import lsd
import lsd.small_table as small
from lsd.utils import *
from lsd.tui import *
import numpy as np

def usage():
	print "Usage: %s <table_name> <filename>" % sys.argv[0]

optlist, (dbdir,), (tabname, files) = tui_getopt('c', ['create'], 2, usage)

create = True

#
# Actual work
#
db = lsd.DB(dbdir)

files = [files]

print "Importing a table:"
small.import_from_catalogs(db, tabname, files, create)
print " done."

print "Building neighbor cache ",
db.build_neighbor_cache(tabname)
print " done."

print "Computing summary statistics ",
db.compute_summary_stats(tabname)
print " done."
print "Total number of objects in table: ", db.table(tabname).nrows()
